{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>open-feature/community-tooling"
  ],
  "packageRules": [
    {
      "description": "Preserve the swift-log lower bound for older Swift toolchains",
      "matchManagers": ["swift"],
      "matchPackageNames": ["apple/swift-log"],
      "rangeStrategy": "replace"
    }
  ]
}
